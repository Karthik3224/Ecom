# Export these values into the environment; the PowerShell launcher does not load this file.
# Generate independent random secrets of at least 32 characters. Do not commit real secrets.
ORDER_SYNC_KEY=
PAYMENT_SYNC_KEY=
FULFILLMENT_SYNC_KEY=
ORDER_SERVICE_URL=http://localhost:3311
PAYMENT_SERVICE_URL=http://localhost:3314
FULFILLMENT_SERVICE_URL=http://localhost:3315
NOTIFICATION_SERVICE_URL=http://localhost:3317
# Review and provision schemas explicitly before startup. Runtime migrations stay disabled.
FLYWAY_ENABLED=false
SPRING_FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
