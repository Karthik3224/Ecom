@baseUrl = http://localhost:8091
@customerId = 11111111-1111-1111-1111-111111111111
@storeId = Pickles & More - Main Store
@cartId = paste-created-cart-id-here
@itemId = paste-created-item-id-here

### Create cart
POST {{baseUrl}}/api/v1/carts
Content-Type: application/json

{
  "customerId": "{{customerId}}",
  "storeId": "{{storeId}}"
}

### Get cart by id
GET {{baseUrl}}/api/v1/carts/{{cartId}}

### Get active cart by customer and store
GET {{baseUrl}}/api/v1/carts/active?customerId={{customerId}}&storeId={{storeId}}

### Add Avakaya Pickle sample item
POST {{baseUrl}}/api/v1/carts/{{cartId}}/items
Content-Type: application/json

{
  "productId": "22222222-2222-2222-2222-222222222222",
  "variantId": "33333333-3333-3333-3333-333333333333",
  "productName": "Avakaya Pickle 500g",
  "quantity": 2,
  "unitPrice": 199.00
}

### Add Lemon Pickle sample item
POST {{baseUrl}}/api/v1/carts/{{cartId}}/items
Content-Type: application/json

{
  "productId": "44444444-4444-4444-4444-444444444444",
  "variantId": "55555555-5555-5555-5555-555555555555",
  "productName": "Lemon Pickle 500g",
  "quantity": 1,
  "unitPrice": 189.00
}

### Add Gongura Pickle sample item
POST {{baseUrl}}/api/v1/carts/{{cartId}}/items
Content-Type: application/json

{
  "productId": "66666666-6666-6666-6666-666666666666",
  "variantId": null,
  "productName": "Gongura Pickle 500g",
  "quantity": 1,
  "unitPrice": 199.00
}

### Update item quantity
PATCH {{baseUrl}}/api/v1/carts/{{cartId}}/items/{{itemId}}
Content-Type: application/json

{
  "quantity": 3
}

### Remove item
DELETE {{baseUrl}}/api/v1/carts/{{cartId}}/items/{{itemId}}

### Clear cart
DELETE {{baseUrl}}/api/v1/carts/{{cartId}}/items

### Calculate cart total
POST {{baseUrl}}/api/v1/carts/{{cartId}}/calculate-total
