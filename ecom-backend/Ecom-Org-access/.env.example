# Ecom-Org-access — environment configuration example.
# Copy to `.env` (or export these in your deploy environment) and fill in real values.
# These are BACKEND-ONLY secrets. Never expose them to the frontend / VITE_ variables.

# ---- Database (schema: users_roles) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-client-mysql-password

# ---- JWT (must match every service that validates org-access tokens) ----
JWT_SECRET=change-this-secret-to-a-long-random-string

# ---- SMTP: required for customer email OTP (sign-up verification + forgot password) ----
# Without SMTP_HOST and SMTP_FROM, /api/auth/customer/otp/send returns HTTP 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=vineethreddy802@gmail.com
SMTP_PASSWORD=
SMTP_FROM=vineethreddy802@gmail.com
# Defaults: SMTP_AUTH=true, SMTP_STARTTLS=true (required). For implicit TLS on 465:
# SMTP_SSL=true and SMTP_STARTTLS=false
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Optional: mobile OTP login (hidden/unavailable unless both are set) ----
# HTTPS endpoint receives JSON {"to":"+919876543210","message":"..."} and must return 2xx only on acceptance.
SMS_OTP_URL=
SMS_OTP_TOKEN=

# ---- Optional: first-run customer link migration (V15) ----
# CUSTOMER_MIGRATION_JDBC_URL=jdbc:mysql://localhost:3306/customer_profiles
# CUSTOMER_MIGRATION_DB_USER=root
# CUSTOMER_MIGRATION_DB_PASSWORD=rootroot

# Downstream services for native/local runs. Docker deployments use container hostnames.
ORDERS_SERVICE_URL=http://127.0.0.1:3311
FULFILLMENT_SERVICE_URL=http://127.0.0.1:3315
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:3317
