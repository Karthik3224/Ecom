[Unit]
Description=E-commerce %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ecom
Group=ecom
EnvironmentFile=/etc/ecom/%i.env
ExecStart=/opt/ecom/current/linux/run-service.sh %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecom
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
